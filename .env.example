# tensor-forge environment configuration.
# Copy to .env and adjust. No real credentials are committed.

# --- Application ---
APP_NAME=tensor-forge
APP_VERSION=1.0.0
ENVIRONMENT=development

# Local-only demo mode. The backend binds 127.0.0.1 in demo mode and refuses
# to run demo mode when ENVIRONMENT=production is configured. Auth (OIDC
# Keycloak) is a planned milestone and will override demo access.
DEMO_MODE=true
HOST=127.0.0.1
PORT=8000

# SQLite storage. In-memory is ":memory:" (default for local dev/tests).
DATABASE_URL="sqlite:///./tensor-forge.db"

# --- LLM advisory (planned milestone, not wired this round) ---
# Deterministic core needs no key. Set only when enabling opt-in LLM refinements.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- OIDC / Keycloak (planned milestone, not enforced this round) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
KEYCLOAK_REALM=tensor-forge